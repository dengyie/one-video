{
  "scenes": [
    {
      "id": "hook",
      "type": "device",
      "enter": "cut",
      "intent": "手机入场，镜头推到播放器：一页放下所有视频",
      "props": {
        "device": "phone",
        "url": "vedio.mangoqwq.com",
        "caption": "一个链接",
        "screens": [
          {
            "id": "home",
            "asset": "home"
          }
        ],
        "steps": [
          {
            "at": 0.9,
            "focus": "player",
            "camera": "page"
          },
          {
            "at": 2.2,
            "camera": "device"
          }
        ]
      }
    },
    {
      "id": "open",
      "type": "device",
      "intent": "点卡片直接打开详情页，停在简介和下载链接上",
      "props": {
        "device": "phone",
        "url": "vedio.mangoqwq.com",
        "screens": [
          {
            "id": "home",
            "asset": "home"
          },
          {
            "id": "detail",
            "asset": "detail"
          }
        ],
        "steps": [
          {
            "at": {
              "phrase": "点开",
              "offset": -0.25
            },
            "snap": false,
            "tap": "card"
          },
          {
            "at": "点开",
            "screen": "detail",
            "focus": "summary"
          }
        ]
      },
      "minDuration": 4.6
    },
    {
      "id": "chapters",
      "type": "device",
      "intent": "点第二章，停在跳转后的播放时间和高亮章节上",
      "props": {
        "device": "phone",
        "url": "vedio.mangoqwq.com",
        "screens": [
          {
            "id": "detail",
            "asset": "detail"
          },
          {
            "id": "chapter-result",
            "asset": "chapter-result"
          }
        ],
        "steps": [
          {
            "at": "点章节",
            "tap": "chapter"
          },
          {
            "at": { "phrase": "点章节", "offset": 0.25 },
            "screen": "chapter-result",
            "focus": [0, 0.078, 1, 0.47]
          }
        ]
      }
    },
    {
      "id": "cta",
      "type": "title",
      "minDuration": 3.5,
      "enter": {
        "type": "zoom",
        "duration": 0.5
      },
      "intent": "收在网址上",
      "props": {
        "kicker": "OneVideo",
        "title": "vedio.mangoqwq.com",
        "subtitle": "打开就能看"
      }
    }
  ]
}
