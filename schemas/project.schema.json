{
  "$id": "onevideo/project",
  "title": "onevideo.json — project config",
  "type": "object",
  "required": [
    "name",
    "title",
    "pipeline",
    "style",
    "aspect"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "pipeline": {
      "type": "string"
    },
    "style": {
      "type": "string"
    },
    "aspect": {
      "enum": [
        "16:9",
        "9:16",
        "1:1",
        "4:5"
      ]
    },
    "fps": {
      "type": "integer",
      "minimum": 24,
      "maximum": 60
    },
    "width": {
      "type": "integer"
    },
    "height": {
      "type": "integer"
    },
    "language": {
      "type": "string"
    },
    "targetSeconds": {
      "type": "number",
      "minimum": 10
    },
    "watermark": {
      "oneOf": [
        {
          "type": [
            "string",
            "null"
          ]
        },
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "sub": {
              "type": "string"
            },
            "logo": {
              "type": "string"
            },
            "icon": {
              "type": "string"
            },
            "position": {
              "enum": [
                "top-right",
                "top-left",
                "bottom-right",
                "bottom-left"
              ]
            },
            "style": {
              "enum": [
                "badge",
                "text"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "theme": {
      "type": "object"
    },
    "lexicon": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseUrl": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "voice": {
          "type": "string"
        },
        "keyEnv": {
          "type": "string"
        },
        "sampleRate": {
          "type": "integer"
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "speed": {
          "type": "number"
        },
        "instructions": {
          "type": "string"
        },
        "protocol": {
          "description": "chat: POST /chat/completions with the style as the user turn and the text as the assistant turn (MiMo TTS); speech: OpenAI-style POST /audio/speech.",
          "enum": [
            "chat",
            "speech"
          ]
        },
        "unit": {
          "description": "scene: one TTS call per scene for natural prosody, caption timing aligned from the pauses in the audio; line: one call per caption line (exact timing, choppier delivery).",
          "enum": [
            "scene",
            "line"
          ]
        },
        "design": {
          "description": "describe the speaker (age, voice, manner — e.g. 六十多岁的老渔夫，嗓音低沉沙哑，不紧不慢): the voicedesign model makes a reference clip once (cached by this text) and the voiceclone model speaks every scene in that voice",
          "type": "string",
          "minLength": 4
        },
        "auditions": {
          "description": "candidate voices for onevideo tts --audition: each a speaker description (or { design, style }); every take reads the opening line into out/audition/voice-<k>.wav",
          "type": "array",
          "maxItems": 6,
          "items": {
            "anyOf": [
              { "type": "string", "minLength": 4 },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["design"],
                "properties": { "design": { "type": "string", "minLength": 4 }, "style": { "type": "string" }, "designText": { "type": "string", "minLength": 4 } }
              }
            ]
          }
        },
        "designText": {
          "description": "what the designed speaker reads for the reference clip",
          "type": "string",
          "minLength": 4
        },
        "designModel": {
          "type": "string"
        },
        "cloneModel": {
          "type": "string"
        },
        "ref": {
          "description": "project-relative WAV recording (5–30 s) of the voice to clone; rename the file to re-synthesize after replacing it",
          "type": "string"
        },
        "style": {
          "description": "Delivery direction for the voice (tone, pace, emphasis). Sent as the chat user turn, or as instructions with protocol speech.",
          "type": "string"
        },
        "tempo": {
          "description": "pace applied after synthesis, pitch kept: \"auto\" brings a narration outside the rate band (gates.syllablesPerSec) into it (×0.85–1.35, one factor for the film), or a factor 0.8–1.5 (1.15 = 15% faster). A designed or cloned voice keeps its speaker's pace whatever style says.",
          "anyOf": [{ "const": "auto" }, { "type": "number", "minimum": 0.8, "maximum": 1.5 }]
        },
        "syllablesPerSecond": {
          "type": "number",
          "minimum": 2,
          "maximum": 9
        },
        "leadIn": {
          "type": "number"
        },
        "tail": {
          "type": "number"
        },
        "pause": {
          "type": "object",
          "properties": {
            "sentence": {
              "type": "number"
            },
            "clause": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "loudness": {
          "description": "Integrated loudness (LUFS) the whole narration is normalized to; false keeps the TTS level.",
          "oneOf": [
            {
              "type": "number",
              "minimum": -30,
              "maximum": -10
            },
            {
              "const": false
            }
          ]
        }
      }
    },
    "captions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxChars": {
          "type": "number",
          "minimum": 6,
          "maximum": 40
        },
        "style": {
          "enum": [
            "line",
            "karaoke",
            "kinetic"
          ]
        }
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "preset": {
          "enum": [
            "ambient",
            "pulse",
            "documentary",
            "bright",
            "story"
          ],
          "description": "story: scored to the cut — intro, rise, turn, climax and resolve follow the script beats (or music.arc), one motif throughout"
        },
        "seed": {
          "type": "integer"
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "duckTo": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "file": {
          "type": "string",
          "description": "path under public/, e.g. music/track.mp3"
        },
        "url": {
          "type": "string",
          "description": "where onevideo music downloads music.file from when it is missing (a licensed track)"
        },
        "credit": {
          "type": "string",
          "description": "title · author · license of music.file, used in publish credits"
        },
        "offset": {
          "description": "seconds into the track the video starts at; \"auto\" picks the start that lands hard cuts on downbeats",
          "oneOf": [
            { "type": "number", "minimum": 0 },
            { "const": "auto" }
          ]
        },
        "arc": {
          "type": "array",
          "description": "story preset: where each mood starts (a scene id or seconds), overriding the script beats",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["at", "mood"],
            "properties": {
              "at": { "oneOf": [{ "type": "string" }, { "type": "number", "minimum": 0 }] },
              "mood": { "enum": ["intro", "rise", "turn", "climax", "resolve"] }
            }
          }
        }
      }
    },
    "sfx": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transition": {
          "type": [
            "string",
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": "sound for every scene boundary, or a map by transition type (\"*\" for the rest)"
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "overlays": {
          "enum": [
            "auto",
            "none"
          ],
          "description": "auto: every overlay without its own sfx plays the sound for its type"
        },
        "motion": {
          "enum": [
            "auto",
            "none"
          ],
          "description": "auto: camera flights, cuts, push-ins, slammed words and footage ramps make their own sounds"
        }
      }
    },
    "image": {
      "type": "object",
      "description": "defaults for generated images: models (fallback order) or model, size, baseUrl, keyEnv",
      "properties": {
        "baseUrl": { "type": "string" },
        "keyEnv": { "type": "string" },
        "model": { "type": "string" },
        "models": { "type": "array", "items": { "type": "string" } },
        "size": { "type": "string" }
      }
    },
    "video": {
      "type": "object",
      "description": "defaults for generated clips (POST /videos task API)",
      "properties": {
        "baseUrl": { "type": "string" },
        "keyEnv": { "type": "string" },
        "model": { "type": "string" },
        "models": { "type": "array", "items": { "type": "string" } },
        "duration": { "type": "number", "minimum": 1, "maximum": 15 },
        "resolution": { "type": "string" },
        "pollSec": { "type": "number" },
        "timeoutSec": { "type": "number" }
      }
    },
    "llm": {
      "type": "object",
      "description": "chat/vision models for onevideo look and picking generated takes; the first model that answers wins",
      "properties": {
        "baseUrl": { "type": "string" },
        "keyEnv": { "type": "string" },
        "models": { "type": "array", "items": { "type": "string" } }
      }
    },
    "publish": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cover": {
          "type": "string"
        }
      }
    },
    "render": {
      "type": "object",
      "properties": {
        "concurrency": {
          "type": "integer"
        },
        "crf": {
          "type": "integer"
        },
        "videoCacheMB": {
          "type": "number",
          "minimum": 64,
          "description": "OffthreadVideo frame cache when the timeline plays video (default 512)"
        }
      }
    },
    "qc": {
      "type": "object"
    },
    "gates": {
      "type": "object"
    },
    "fiction": {
      "type": "boolean",
      "description": "A made-up story: the research stage is optional (no facts to source) and narration numbers are not held to research.json unless one is written."
    },
    "drawn": {
      "type": "boolean",
      "description": "Every frame is drawn by code (pipeline graphics): no photos, footage, captures or generated media; the drawn gate holds the storyboard to it."
    },
    "look": {
      "type": "object",
      "additionalProperties": false,
      "description": "whole-video finish over every scene",
      "properties": {
        "grain": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "vignette": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "leak": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "beats": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snap": {
          "type": "boolean",
          "description": "snap shot times to music beats within 0.12 s (default true)"
        }
      }
    }
  }
}
