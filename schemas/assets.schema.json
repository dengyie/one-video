{
  "$id": "onevideo/assets",
  "title": "plan/assets.json — media manifest with provenance",
  "type": "object",
  "required": [
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "kind": {
          "enum": [
            "image",
            "video"
          ]
        },
        "query": {
          "type": "string"
        },
        "provider": {
          "oneOf": [
            {
              "enum": [
                "nasa",
                "wikimedia",
                "openverse",
                "pexels"
              ]
            },
            {
              "type": "array",
              "items": {
                "enum": [
                  "nasa",
                  "wikimedia",
                  "openverse",
                  "pexels"
                ]
              }
            }
          ]
        },
        "clip": {
          "type": "array",
          "description": "video: [start, seconds] window cut from the source (default the first 20 s, max 60 s)",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 1,
          "maxItems": 2
        },
        "duration": {
          "type": [
            "number",
            "null"
          ]
        },
        "pick": {
          "type": "integer",
          "minimum": 0
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "generate": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "required": [
                "prompt"
              ],
              "properties": {
                "prompt": {
                  "type": "string"
                },
                "model": {
                  "type": "string"
                },
                "size": {
                  "type": "string"
                },
                "models": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "fallback order; model pins one"
                },
                "variants": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4,
                  "description": "image: make N takes; a vision model picks the best (or pick)"
                },
                "pick": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "image: take index to keep instead of the vision pick"
                },
                "brief": {
                  "type": "string",
                  "description": "what the shot must do, for the vision pick"
                },
                "from": {
                  "type": "string",
                  "description": "video: id of an image asset to animate as the first frame"
                },
                "duration": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 15,
                  "description": "video: seconds (default 6)"
                },
                "resolution": {
                  "type": "string",
                  "description": "video: e.g. 720p"
                },
                "inspect": {
                  "type": "boolean",
                  "description": "video: read the take as a contact sheet and keep its longest clean stretch (default true; an explicit clip skips it)"
                },
                "keep": {
                  "type": "number",
                  "minimum": 1,
                  "description": "video: at most this many seconds of the take are kept"
                },
                "still": {
                  "type": "boolean",
                  "description": "video with from: when generation fails, stand in as the from still (default true)"
                }
              },
              "description": "AI generation through the relay. kind image: /images/generations; kind video: /videos (text-to-video, or image-to-video with from). A failure falls back to query/url when present.",
              "additionalProperties": false
            }
          ]
        },
        "file": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "width": {
          "type": [
            "integer",
            "null"
          ]
        },
        "height": {
          "type": [
            "integer",
            "null"
          ]
        },
        "fetchedAt": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "via": {
          "enum": [
            "url",
            "generate",
            "nasa",
            "wikimedia",
            "openverse",
            "pexels",
            "capture",
            "still"
          ]
        },
        "takes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "picked": {
          "type": "integer"
        },
        "pickedBy": {
          "type": "string"
        },
        "pickReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "inspect": {
          "type": "object",
          "description": "generated video: the vision check of the take (score, issues by second, kept [start, seconds])"
        },
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from"
          ],
          "description": "a still standing in for a clip whose generation failed; assets fetch tries the clip again",
          "properties": {
            "from": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          }
        },
        "capture": {
          "type": "object",
          "additionalProperties": false,
          "description": "how onevideo capture shot this UI: re-run with the same settings to refresh it",
          "properties": {
            "url": {
              "type": "string"
            },
            "device": {
              "enum": [
                "phone",
                "tablet",
                "desktop"
              ]
            },
            "viewport": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "minItems": 2,
              "maxItems": 2
            },
            "full": {
              "type": "boolean"
            },
            "dark": {
              "type": "boolean"
            },
            "wait": {
              "type": "integer",
              "minimum": 0
            },
            "click": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "selectors": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "rects": {
          "type": "object",
          "description": "named regions of a UI capture, [x, y, w, h] in 0–1 of the image (onevideo capture --rects)",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 4,
            "maxItems": 4
          }
        }
      }
    }
  }
}
